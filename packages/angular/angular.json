{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false,
    "packageManager": "bun"
  },
  "projects": {
    "docx-editor-angular": {
      "projectType": "library",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build-test": {
          "builder": "@angular/build:application",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "preserveSymlinks": false,
            "allowedCommonJsDependencies": ["utif2", "pako"]
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "docx-editor-angular:build-test",
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "include": ["src/**/*.spec.ts"],
            "watch": false,
            "setupFiles": ["src/test-setup.ts"]
          }
        }
      }
    }
  }
}
