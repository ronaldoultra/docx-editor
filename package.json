{
  "name": "docx-editor-monorepo",
  "version": "0.0.21",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/angular"
  ],
  "type": "module",
  "scripts": {
    "api:check": "node scripts/api-extractor.mjs",
    "api:extract": "node scripts/api-extractor.mjs --local",
    "build": "bun run build:packages && bun run --filter './examples/angular' build",
    "build:packages": "bun run --filter '@docx-editor.dev/i18n' build && bun run --filter '@docx-editor.dev/core' build && bun run --filter '@docx-editor.dev/fonts' build && bun run --filter '@docx-editor.dev/vue' build && bun run --filter '@docx-editor.dev/angular' build",
    "check:core-css-compiled": "node scripts/check-core-css-compiled.mjs",
    "check:font-width-fidelity": "bun packages/fonts/scripts/check-width-fidelity.ts",
    "check:fonts-manifest": "cd packages/fonts && node scripts/generate-manifest.mjs --check",
    "check:google-catalog": "cd packages/fonts && node scripts/generate-google-catalog.mjs --check",
    "check:i18n-bundle-size": "node scripts/check-i18n-bundle-size.mjs",
    "check:lane-boundaries": "node scripts/check-lane-boundaries.mjs",
    "check:lockfile-workspaces": "node scripts/check-lockfile-workspaces.mjs",
    "check:shipped-advisories": "node scripts/check-shipped-advisories.mjs",
    "check:shipped-shaper": "node scripts/check-shipped-shaper.mjs",
    "check:tsconfig-lib-floor": "node scripts/check-tsconfig-lib-floor.mjs",
    "dev": "bun run --filter './examples/angular' dev",
    "dev:angular": "bun run --filter './examples/angular' dev",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,js,jsx,json,css}\" \"examples/*/src/**/*.{ts,css,html}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx,js,jsx,json,css}\" \"examples/*/src/**/*.{ts,css,html}\"",
    "i18n:codegen": "node scripts/validate-i18n.mjs codegen",
    "i18n:fix": "node scripts/validate-i18n.mjs validate --fix",
    "i18n:new": "node scripts/validate-i18n.mjs new",
    "i18n:status": "node scripts/validate-i18n.mjs status",
    "i18n:unused": "node scripts/check-i18n-unused.mjs --list",
    "i18n:validate": "node scripts/validate-i18n.mjs validate",
    "lint": "node scripts/check-max-lines-caps.mjs && node scripts/check-lockfile-workspaces.mjs && oxlint --report-unused-disable-directives-severity=warn packages/*/src/ examples/*/src/",
    "lint:fix": "node scripts/check-max-lines-caps.mjs && oxlint --report-unused-disable-directives-severity=warn --fix packages/*/src/ examples/*/src/",
    "prepare": "husky && bun run --filter '@docx-editor.dev/i18n' build",
    "reference:fetch": "node scripts/fetch-reference.mjs",
    "test": "node scripts/test/run-parallel.mjs",
    "test:changed": "node scripts/test/changed.mjs",
    "test:e2e:angular": "playwright test --config examples/angular/e2e/playwright.config.ts",
    "test:serial": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "bun run --filter '*' typecheck",
    "typecheck:root": "bun check -p tsconfig.json"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@microsoft/api-extractor": "^7.60.1",
    "@playwright/test": "^1.65.0",
    "@types/bun": "^1.4.4",
    "autoprefixer": "^10.6.2",
    "cssnano": "^9.9.0",
    "fast-xml-parser": "5.12.0",
    "fflate": "^0.8.3",
    "husky": "^9.1.7",
    "jszip": "^3.10.2",
    "lint-staged": "^17.6.0",
    "oxlint": "1.93.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "rollup": "^4.68.2",
    "rollup-plugin-dts": "^6.5.1",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.3.7",
    "vue": "^3.5.45"
  },
  "keywords": [
    "docx",
    "editor",
    "template",
    "word",
    "document",
    "angular",
    "prosemirror"
  ],
  "author": "Eigenpal, Inc.",
  "license": "Apache-2.0",
  "homepage": "https://docx-editor.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/eigenpal/docx-editor.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "vite": {
      "postcss": "8.5.32"
    },
    "prosemirror-view": "1.42.3",
    "prosemirror-state": "1.4.4",
    "prosemirror-model": "1.25.4",
    "prosemirror-transform": "1.12.0",
    "@happy-dom/global-registrator": "21.0.4",
    "happy-dom": "21.0.4",
    "vue": "3.5.45"
  },
  "resolutions": {
    "prosemirror-view": "1.42.3",
    "prosemirror-state": "1.4.4",
    "prosemirror-model": "1.25.4",
    "prosemirror-transform": "1.12.0",
    "@happy-dom/global-registrator": "21.0.4",
    "happy-dom": "21.0.4",
    "vue": "3.5.45"
  },
  "dependencies": {
    "@docx-editor.dev/core": "workspace:*"
  }
}
