{
  "compilerOptions": {
    // ES2022: core's sources use ES2022 features, so every program that compiles them needs
    // the same floor.
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "declarationMap": true,
    // Core resolves to SOURCE here. Without it, this project held two copies of the engine:
    // `dist` for imports by package name, and `src` for harnesses that import by relative
    // path. Identical classes from two copies are different types.
    "paths": {
      "@docx-editor.dev/core": ["./packages/core/src/index.ts"],
      "@docx-editor.dev/core/*": ["./packages/core/src/*"],
      "@docx-editor.dev/i18n": ["./packages/i18n/src/index.ts"]
    }
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
